{
  "name": "solidjs-monorepo-starter",
  "version": "0.0.0",
  "description": "A security-focused SolidJS and Go monorepo starter designed for fast prototyping and clear application boundaries.",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "build:reference-app": "vite build projects/reference-app --config vite.config.mts",
    "dev:reference-app": "vite projects/reference-app --config vite.config.mts",
    "test:reference-app": "vitest run --config vitest.config.mts",
    "typecheck:reference-app": "tsc --project projects/reference-app/tsconfig.json",
    "verify": "node tools/scripts/verify.mjs"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.19",
    "solid-js": "2.0.0-rc.19"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
